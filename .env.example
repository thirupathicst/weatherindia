# Mausam App Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# API Configuration
API_TIMEOUT=10000

# Weather API (if using external APIs)
# WEATHER_API_KEY=your_key_here

# CORS Settings
CORS_ORIGIN=*

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379
